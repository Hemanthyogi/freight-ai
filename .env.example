# ============================================================
# FreightMind AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# App
APP_ENV=development          # development | production
APP_DEBUG=true
APP_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./freightmind.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/freightmind

# Demo mode flag — set to true to use synthetic/demo data
DEMO_MODE=true

# External Data APIs (optional — only needed for real-data mode)
# NASDAQ_DATA_LINK_KEY=your_key_here
# MARINE_TRAFFIC_API_KEY=your_key_here
# WORLD_BANK_API_KEY=not_required   # World Bank is open

# Model paths
MODELS_DIR=./models
DATA_DIR=./data

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
